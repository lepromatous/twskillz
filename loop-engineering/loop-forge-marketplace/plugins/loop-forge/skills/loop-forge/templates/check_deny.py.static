#!/usr/bin/env python3
"""harness/check_deny.py — mechanical enforcement of gate.yaml:deny.

Called BEFORE verification, by run_loop.sh and by the pre-commit hook. Order
matters: if the agent edited what it is judged against, a green gate set means
nothing.

Exit 0 clean, 1 violation.
"""
import fnmatch
import pathlib
import sys

try:
    import yaml
    deny = yaml.safe_load(pathlib.Path("gate.yaml").read_text()).get("deny", [])
except Exception:
    # No gate.yaml, or no pyyaml: fail closed rather than open. A denylist that
    # silently does nothing is worse than no denylist, because people trust it.
    print("check_deny: cannot read gate.yaml -- refusing to proceed", file=sys.stderr)
    sys.exit(1)

hits = [p for p in sys.argv[1:] if p for pat in deny if fnmatch.fnmatch(p, pat)]
if hits:
    print("DENYLIST VIOLATION -- these are the loop's own success criteria:", file=sys.stderr)
    for h in sorted(set(hits)):
        print(f"  {h}", file=sys.stderr)
    print("\nAn agent that can edit its own contracts has no contracts.", file=sys.stderr)
    sys.exit(1)
sys.exit(0)

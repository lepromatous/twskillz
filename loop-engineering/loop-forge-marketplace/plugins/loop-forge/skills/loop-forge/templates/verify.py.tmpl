#!/usr/bin/env python3
"""harness/verify.py — the verifier for {{ project.name }}.

Generated by loop-forge. This is the file that makes the loop closable; everything
else is scaffolding around the question it answers: *is it done?*

Two design rules are load-bearing and you should not generate around them:

  1. SUCCESS IS SILENT, FAILURE IS VERBOSE. A passing gate emits nothing into the
     agent's context. A failing gate emits everything needed to fix it. That text
     is not a log -- it is literally the next prompt.

  2. COMPUTATIONAL BEFORE INFERENTIAL. Gates here are deterministic: same input,
     same verdict, no tokens, no network. Model-judged checks are dispatched by
     run_loop.sh and advise rather than block.

Verifier pattern: {{ verify.pattern }}

Usage:
    python harness/verify.py --all
    python harness/verify.py --gates {{ verify.first_gate }}
    python harness/verify.py --all --json

Exit: 0 all blocking gates green | 1 a blocking gate failed
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from dataclasses import dataclass, asdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# Each gate is (id, human name, shell command, blocking).
# Ordered cheapest first so the loop fails fast and cheap.
GATES = [
{% for g in verify.gates %}    ("{{ g.id }}", "{{ g.name }}", {{ g.cmd_repr }}, True),
{% endfor %}]


@dataclass
class Result:
    gate: str
    name: str
    status: str          # pass | fail
    blocking: bool
    output: str = ""

    def render(self) -> str:
        """Empty on pass. See design rule 1."""
        if self.status == "pass":
            return ""
        lines = [f"[FAIL] {self.gate} -- {self.name}"]
        lines += [f"       {ln}" for ln in self.output.splitlines()[:40]]
        return "\n".join(lines)


def run_gate(gate_id: str, name: str, cmd: str, blocking: bool) -> Result:
    try:
        p = subprocess.run(cmd, shell=True, cwd=ROOT,
                           capture_output=True, text=True, timeout=600)
        out = (p.stdout + p.stderr).strip()
        ok = p.returncode == 0
    except subprocess.TimeoutExpired:
        return Result(gate_id, name, "fail", blocking,
                      f"timed out after 600s: {cmd}")
    return Result(gate_id, name, "pass" if ok else "fail", blocking, out)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--gates", default="", help="comma-separated ids, e.g. {{ verify.first_gate }}")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if not a.all and not a.gates:
        ap.error("pass --all or --gates")

    wanted = ([g.strip() for g in a.gates.split(",")] if a.gates
              else [g[0] for g in GATES])
    results = [run_gate(*g) for g in GATES if g[0] in wanted]

    if a.json:
        print(json.dumps([asdict(r) for r in results], indent=2))
    else:
        noise = [r.render() for r in results if r.render()]
        print("\n".join(noise) if noise else "")
        n_ok = sum(r.status == "pass" for r in results)
        n_bad = len(results) - n_ok
        print(f"\n{n_ok} passed, {n_bad} failed", file=sys.stderr)

    return 1 if any(r.status == "fail" and r.blocking for r in results) else 0


if __name__ == "__main__":
    sys.exit(main())
